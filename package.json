{
  "name": "synech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Local-first agent workspace.",
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "clean:workspace": "node scripts/clean-workspace.mjs",
    "reset:product-home": "node scripts/reset-product-home.mjs",
    "build": "pnpm clean:dist && pnpm build:node && pnpm check:baseline && pnpm copy:sub-agents && pnpm typecheck:panel && pnpm build:panel",
    "build:node": "pnpm generate:icons && tsc -p tsconfig.json && pnpm copy:initial-workbench-assets",
    "copy:initial-workbench-assets": "node scripts/copy-initial-workbench-assets.mjs",
    "copy:sub-agents": "node scripts/copy-sub-agent-assets.mjs",
    "check:architecture": "node scripts/check-module-cycles.mjs",
    "check:baseline": "pnpm check:architecture && node scripts/check-architecture-baseline.mjs",
    "check:whitespace": "node scripts/check-whitespace.mjs",
    "verify": "pnpm build && pnpm typecheck:panel && pnpm build:panel && pnpm panel:desktop:smoke && pnpm check:whitespace",
    "typecheck:panel": "tsc -p tsconfig.panel.json --noEmit",
    "build:panel": "vite build --config vite.panel.config.ts",
    "smoke:real-ai": "pnpm build && node dist/app/real-ai-smoke.js",
    "panel": "pnpm build && node dist/app/panel.js",
    "panel:dev": "node scripts/panel-dev.mjs",
    "panel:desktop:dev": "node scripts/panel-dev.mjs --desktop",
    "panel:desktop:dev:no-restart": "node scripts/panel-dev.mjs --desktop --no-restart",
    "panel:smoke": "pnpm build && node dist/app/panel.js --port 0 --smoke",
    "panel:desktop": "pnpm build && pnpm exec electron dist/app/panel-desktop.js",
    "panel:desktop:smoke": "pnpm build && node scripts/panel-desktop-smoke.mjs",
    "generate:icons": "node scripts/generate-icon-assets.mjs",
    "installer-shell:dev": "pnpm exec vite --config packaging/windows/installer-shell/vite.dev-preview.config.ts",
    "build:installer-shell:web": "pnpm exec tsc --noEmit -p packaging/windows/installer-shell/tsconfig.json && pnpm exec vite build --config packaging/windows/installer-shell/vite.config.ts",
    "build:installer-shell": "node scripts/build-windows-installer-shell.mjs",
    "build:installer-demo": "node scripts/build-windows-installer-demo.mjs",
    "dist:desktop:win:backend": "pnpm build && node scripts/build-windows-nsis-backend.mjs",
    "dist:desktop:win": "pnpm dist:desktop:win:backend && pnpm build:installer-shell"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "5.101.2",
    "@tiptap/extension-image": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-table": "^3.29.1",
    "@tiptap/extension-task-item": "^3.29.1",
    "@tiptap/extension-task-list": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "chardet": "^2.2.0",
    "diff": "9.0.0",
    "docx-preview": "0.4.0",
    "iconv-lite": "^0.7.3",
    "js-tiktoken": "^1.0.21",
    "lowlight": "^3.3.0",
    "lucide-react": "0.487.0",
    "motion": "^12.23.24",
    "react": "^19.2.6",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.1",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "1.3.8",
    "unpdf": "1.6.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "main": "dist/app/panel-desktop.js",
  "productName": "Synech"
}
